DOMAIN_NAME="example.com"
BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"

# ---------------------
# 
# AUTHENTICATION
# 
# ---------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# ---------------------
# 
# STRIPE
# 
# ---------------------
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_
STRIPE_SECRET_KEY=sk_
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_
STRIPE_DEFAULT_TAX_RATE_ID=txr_
PRO_MONTHLY_PRICE_ID=price_
PRO_YEARLY_PRICE_ID=price_
AGENCY_MONTHLY_PRICE_ID=price_
AGENCY_YEARLY_PRICE_ID=price_

# ---------------------
#
# MAILER
#
# ---------------------
# MAIL_PROVIDER: smtp | resend | plunk. Inferred from the credentials below when unset.
MAIL_PROVIDER=smtp

# SMTP (recommended for self-hosting – any relay works)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true                      # implicit TLS (465); STARTTLS on 587 is automatic
# SMTP_TLS_REJECT_UNAUTHORIZED=false    # self-signed internal relays only

# Hosted providers (cloud deployment)
PLUNK_SECRET_KEY=
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# ---------------------
#
# STORAGE (screenshots, avatars, logos)
#
# ---------------------
# STORAGE_PROVIDER: database (files in Postgres, default) | s3 (any S3-compatible) | aws | r2
STORAGE_PROVIDER=database
# Must match STORAGE_PROVIDER; compiled into the frontend to pick the upload flow.
NEXT_PUBLIC_STORAGE_PROVIDER=database
# Public base URL for avatars/logos: "/api/assets" for database, the bucket's public URL otherwise.
NEXT_PUBLIC_STORAGE_BASE_URL=/api/assets

# s3 / aws
STORAGE_BUCKET_NAME=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=                      # s3 only; server-side endpoint
STORAGE_PUBLIC_ENDPOINT=               # s3 only; what browsers open, when different from STORAGE_ENDPOINT
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=false        # default true (MinIO); false for virtual-hosted buckets

# r2 (Cloudflare)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ---------------------
#
# FEEDBACK WIDGET
#
# ---------------------
NEXT_PUBLIC_FF_API_KEY=""
NEXT_PUBLIC_FF_API_ORIGIN=http://localhost:3000

# ---------------------
#
# GITHUB APP
#
# ---------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=          # Full PEM content with \n as literal newlines
GITHUB_WEBHOOK_SECRET=       # High-entropy random string for webhook signature verification

# ---------------------
#
# LINEAR INTEGRATION
#
# ---------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=    # Optional override; defaults to $BETTER_AUTH_URL/api/linear/callback
LINEAR_WEBHOOK_SIGNING_SECRET= # App-level webhook secret from Linear's OAuth app settings
LINEAR_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# SLACK INTEGRATION
#
# ---------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# JIRA INTEGRATION
#
# ---------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=        # optional; falls back to BETTER_AUTH_URL/BASE_URL + /api/jira/callback
JIRA_TOKEN_ENCRYPTION_KEY=      # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration
JIRA_WEBHOOK_BASE_URL=          # optional; public base URL Jira delivers webhooks to (use a tunnel locally), falls back to BETTER_AUTH_URL/BASE_URL


# ---------------------
#
# BACKGROUND JOBS (pg-boss, in Postgres – nothing required)
#
# ---------------------
# JOBS_WORKER=false             # don't run the worker in this process
# JOBS_CRON_TZ=UTC
# JOBS_DB_SCHEMA=pgboss
# JOBS_DB_POOL_MAX=3

# ---------------------
#
# ANALYTICS (optional, self-hosted Umami)
#
# ---------------------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ---------------------
#
# DEPLOYMENT MODE
#
# ---------------------
# Set to "true" on the official hosted version to enable marketing pages (home, pricing, blog, docs, legal).
# Self-hosted instances leave this unset or "false" — users are redirected straight to /login.
NEXT_PUBLIC_IS_CLOUD=false