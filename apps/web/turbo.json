{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DOMAIN_NAME",
        "DATABASE_URL",

        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BASE_URL",

        "NEXT_PUBLIC_STRIPE_PUBLIC_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SIGNING_SECRET",
        "PRO_MONTHLY_PRICE_ID",
        "PRO_YEARLY_PRICE_ID",
        "AGENCY_MONTHLY_PRICE_ID",
        "AGENCY_YEARLY_PRICE_ID",

        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_NOREPLY_FROM",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_SECURE",
        "SMTP_TLS_REJECT_UNAUTHORIZED",
        "PLUNK_SECRET_KEY",
        "RESEND_API_KEY",
        "RESEND_SEGMENT_ID",

        "STORAGE_PROVIDER",
        "STORAGE_DIR",
        "STORAGE_ENDPOINT",
        "STORAGE_PUBLIC_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET_NAME",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_FORCE_PATH_STYLE",
        "NEXT_PUBLIC_STORAGE_BASE_URL",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",

        "NEXT_PUBLIC_STORAGE_PROVIDER",
        "ASSET_URL_SECRET",
        "NEXT_RUNTIME",
        "NEXT_PHASE",
        "JOBS_WORKER",
        "JOBS_CRON_TZ",
        "JOBS_DB_SCHEMA",
        "JOBS_DB_POOL_MAX",
        "NEXT_PUBLIC_UMAMI_SCRIPT_URL",
        "NEXT_PUBLIC_UMAMI_WEBSITE_ID",
        "NEXT_PUBLIC_IS_CLOUD",

        "GITHUB_APP_ID",
        "GITHUB_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",
        "NEXT_PUBLIC_GITHUB_APP_NAME",

        "LINEAR_CLIENT_ID",
        "LINEAR_CLIENT_SECRET",
        "LINEAR_OAUTH_REDIRECT_URI",
        "LINEAR_WEBHOOK_SIGNING_SECRET",
        "LINEAR_TOKEN_ENCRYPTION_KEY",

        "JIRA_CLIENT_ID",
        "JIRA_CLIENT_SECRET",
        "JIRA_OAUTH_REDIRECT_URI",
        "JIRA_TOKEN_ENCRYPTION_KEY",
        "JIRA_WEBHOOK_BASE_URL",

        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "SLACK_TOKEN_ENCRYPTION_KEY"
      ]
    }
  }
}
