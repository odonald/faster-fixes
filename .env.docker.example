# Copy to .env next to docker-compose.yml. Everything here has a working local
# default; for a real server change the URLs, secrets, and SMTP settings.

# --- Core -------------------------------------------------------------------
# Host only, no scheme. Used for auth trusted origins and the sender address.
DOMAIN_NAME=localhost
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-openssl-rand-base64-32

# --- Postgres (docker-compose builds DATABASE_URL from these) ---------------
POSTGRES_USER=fasterfixes
POSTGRES_PASSWORD=fasterfixes
POSTGRES_DB=fasterfixes

# --- Mail (SMTP) ------------------------------------------------------------
# Mailpit from docker-compose. On a server: your relay, e.g. smtp.mailbox.org:587
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true          # implicit TLS (port 465); STARTTLS on 587 is automatic
# SMTP_TLS_REJECT_UNAUTHORIZED=false   # only for self-signed internal relays

# --- Screenshot storage (MinIO from docker-compose) -------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_BUCKET_NAME=faster-fixes
# Public URL of MinIO as seen by browsers (presigned URLs point here).
# The web container talks to MinIO internally; this is only for browser-facing URLs.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000/faster-fixes

# --- Analytics (optional, your own Umami) ------------------------------------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Background jobs (optional) ---------------------------------------------
# Leave empty to run without Inngest. Set both to enable GitHub/Linear/Jira/Slack
# sync via Inngest Cloud or a self-hosted Inngest server (add INNGEST_BASE_URL).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_BASE_URL=http://inngest:8288

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
