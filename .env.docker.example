# Copy to .env next to docker-compose.yml. Everything here has a working local
# default; for a real server change the URLs, secrets, and SMTP settings.

# --- Core -------------------------------------------------------------------
# Host only, no scheme. Used for auth trusted origins and the sender address.
DOMAIN_NAME=localhost
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-openssl-rand-base64-32

# --- Postgres (docker-compose builds DATABASE_URL from these) ---------------
POSTGRES_USER=fasterfixes
POSTGRES_PASSWORD=fasterfixes
POSTGRES_DB=fasterfixes

# --- Mail (SMTP) ------------------------------------------------------------
# Mailpit from docker-compose. On a server: your relay, e.g. smtp.mailbox.org:587
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true          # implicit TLS (port 465); STARTTLS on 587 is automatic
# SMTP_TLS_REJECT_UNAUTHORIZED=false   # only for self-signed internal relays

# --- File storage (screenshots, avatars, logos) ------------------------------
# filesystem (default): files in a folder on disk – docker-compose mounts the
#   `uploads-data` volume at /data/uploads; on Easypanel mount a volume there.
# database: file bytes in Postgres (nothing to mount, one backup covers all).
# s3: any S3-compatible bucket – uncomment and fill in.
STORAGE_PROVIDER=filesystem
# STORAGE_PROVIDER=database
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=http://minio:9000            # server-side endpoint
# STORAGE_PUBLIC_ENDPOINT=https://s3.example.com  # what browsers open (presigned URLs)
# STORAGE_BUCKET_NAME=faster-fixes
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_STORAGE_BASE_URL=https://s3.example.com/faster-fixes

# --- Analytics (optional, your own Umami) ------------------------------------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Background jobs --------------------------------------------------------
# Run in-process on Postgres (pg-boss). Nothing to configure.
# JOBS_WORKER=false     # disable the worker in this replica (e.g. run it in a separate one)
# JOBS_CRON_TZ=Europe/Berlin

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
MAILPIT_UI_PORT=8025
